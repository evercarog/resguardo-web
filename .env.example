# Copia este archivo como .env y rellena los datos de tu proyecto de Supabase
# (Project Settings → API). Solo la URL y la clave publicable (anon):
# NUNCA la clave service_role / secret.
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave pública VAPID de las notificaciones (supabase secrets VAPID_PUBLIC_KEY).
PUBLIC_VAPID_KEY=
